[sub_resource type="Resource" id="table"]
script = ExtResource("bg")
name = "ashely2_TABLE__DRESSED"
imagePath = "res://data/background_lists/ashely_poker2/TABLE__DRESSED/06.webp"
wallpaperId = ""

[resource]
script = ExtResource("stage")
name = "ashely2_ending"
displayName = "Ashely Poker II - Ending"
dialogue = ExtResource("dialogue")
dialogueStartKey = "START"
guaranteedNextGameStage = ExtResource("phone")
isCompletable = true
startingBackground = SubResource("table")
markStagesCompleteOnSceneEnd = Array[String](["ashely2_intro"])
endOnlyOnSpecificDialogueKey = true
endingDialogueKeys = Array[String](["FORFEIT_NAKED_RUN__DRESSED", "FORFEIT_NAKED_RUN__TOP_OFF", "FINAL__DRESSED", "FINAL__TOP_OFF", "FINAL__PANTIES", "FINAL__NAKED", "THE_END__X4_SEX", "THE_END__X4_BJ", "THE_END__X3_BJ__TOP_OFF", "THE_END__L4_KISS", "THE_END__MR1_FINGER"])
choicesScript = ExtResource("choices")
randomMusic = Array[AudioStream]([ExtResource("music_1"), ExtResource("music_2"), ExtResource("music_3"), ExtResource("music_4"), ExtResource("music_5"), ExtResource("music_6")])
