"options": {
0: {
"condition": {},
"link": &"1_1275",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": ""
},
&"1_1275": {
"background": 1,
"backgroundList": 18,
"characterState": -1,
"dialogue": "The rhythm turns urgent.",
"offset": Vector2(48080, 10500),
"options": {
0: {
"condition": {},
"link": &"1_1276",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": ""
},
&"1_1276": {
"background": 1,
"backgroundList": 18,
"characterState": -1,
"dialogue": "Her nails dig into your shoulders. Her breath comes faster and faster against your lips...",
"offset": Vector2(48440, 10500),
"options": {
0: {
"condition": {},
"link": &"1_1277",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": ""
},
&"1_1277": {
"background": 1,
"backgroundList": 18,
"characterState": -1,
"dialogue": "Then she shudders.",
"offset": Vector2(48800, 10500),
"options": {
0: {
"condition": {},
"link": &"1_1278",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": ""
},
&"1_1278": {
"background": 1,
"backgroundList": 18,
"characterState": -1,
"dialogue": "Her whole body goes tight around you, and she muffles a cry against your mouth.",
"offset": Vector2(49160, 10500),
"options": {
0: {
"condition": {},
"link": &"1_1279",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": ""
},
&"1_1279": {
"background": 1,
"backgroundList": 18,
"characterState": -1,
"dialogue": "That's all it takes.",
"offset": Vector2(49520, 10500),
"options": {
0: {
"condition": {},
