},
&"1_1641": {
"background": 3,
"backgroundList": 39,
"characterState": -1,
"dialogue": "Okay. Let me show you what you looked like a minute ago.",
"offset": Vector2(9200, 21000),
"options": {
0: {
"condition": {},
"link": &"1_1642",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": 0
},
&"1_1642": {
"background": 3,
"backgroundList": 39,
"characterState": -1,
"dialogue": "You fold your arms over your chest, scrunch up your face, and stick your bottom lip out as far as it'll go.",
"offset": Vector2(9560, 21000),
"options": {
0: {
"condition": {},
"link": &"1_1643",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": ""
},
&"1_1643": {
"background": 3,
"backgroundList": 39,
"characterState": -1,
"dialogue": "\"A smile? You want me to [i]smile[/i]?\"",
"offset": Vector2(9920, 21000),
"options": {
0: {
"condition": {},
"link": &"1_1686",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": 0
},
&"1_1686": {
"background": 3,
"backgroundList": 39,
"characterState": -1,
"dialogue": "You say, pitching your voice up to sound like a woman",
