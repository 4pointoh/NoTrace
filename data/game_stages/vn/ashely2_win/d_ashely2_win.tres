"condition": {},
"link": &"1_1269",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": 1
},
&"1_1269": {
"background": 5,
"backgroundList": 18,
"characterState": -1,
"dialogue": "Then she starts moving again, faster than before.",
"offset": Vector2(45200, 10500),
"options": {
0: {
"condition": {},
"link": &"3_139",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": ""
},
