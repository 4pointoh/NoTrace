"signalValue": "fade_next"
},
&"1_1270": {
"background": 2,
"backgroundList": 18,
"characterState": -1,
"dialogue": "You couldn't say which of you starts it.",
"offset": Vector2(45920, 10500),
"options": {
0: {
"condition": {},
"link": &"1_1271",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": ""
},
&"1_1271": {
"background": 2,
"backgroundList": 18,
"characterState": -1,
"dialogue": "One second she's teasing you, and the next her mouth is on yours.",
"offset": Vector2(46280, 10500),
"options": {
0: {
"condition": {},
"link": &"1_1272",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": ""
},
&"1_1272": {
"background": 2,
"backgroundList": 18,
"characterState": -1,
"dialogue": "It isn't gentle. It isn't polite.",
"offset": Vector2(46640, 10500),
"options": {
0: {
"condition": {},
"link": &"1_1273",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": ""
},
&"1_1273": {
"background": 2,
"backgroundList": 18,
"characterState": -1,
"dialogue": "And she doesn't pull away.",
