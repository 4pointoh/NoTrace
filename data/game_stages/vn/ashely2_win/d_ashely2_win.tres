"options": {
0: {
"condition": {},
"link": &"1_1644",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": ""
},
&"1_1644": {
"background": 3,
"backgroundList": 39,
"characterState": -1,
"dialogue": "She looks away, biting the inside of her cheek.",
"offset": Vector2(10640, 21000),
"options": {
0: {
"condition": {},
"link": &"1_1645",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": ""
},
&"1_1645": {
"background": 3,
"backgroundList": 39,
"characterState": -1,
"dialogue": "That is [i]not[/i] what I sound like.",
