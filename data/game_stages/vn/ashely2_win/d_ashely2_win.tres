"options": {
0: {
"condition": {},
"link": &"1_1638",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": 0
},
&"1_1638": {
"background": 1,
"backgroundList": 39,
"characterState": -1,
"dialogue": "It [i]was[/i]. You're the gun.",
"offset": Vector2(7760, 21000),
"options": {
0: {
"condition": {},
"link": &"1_1639",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": 1
},
&"1_1639": {
"background": 1,
"backgroundList": 39,
"characterState": -1,
"dialogue": "A real smile. That was the deal.",
"offset": Vector2(8120, 21000),
"options": {
0: {
"condition": {},
"link": &"1_1640",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": 0
},
&"1_1640": {
"background": 1,
"backgroundList": 39,
"characterState": -1,
"dialogue": "I can't just do it on command, you know!",
