"options": {
0: {
"condition": {},
"link": &"1_1646",
"text": ""
}
},
"size": Vector2(300, 640),
"speaker": 1
},
&"1_1646": {
"background": 3,
"backgroundList": 39,
"characterState": -1,
"dialogue": "\"You want me to smile? What the fuck?!\"",
