"offset": Vector2(47360, 10500),
"signalValue": "fade_next"
},
&"1_1274": {
"background": 1,
"backgroundList": 18,
"characterState": -1,
"dialogue": "She wraps her arms around your neck and pulls herself closer, still kissing you.",
