endingDialogueKeys = Array[String](["NEXT_MATCH", "TO_ENDING"])
choicesScript = ExtResource("choices")
skipsOnlySeenDialogue = true
randomMusic = Array[AudioStream]([ExtResource("music_1"), ExtResource("music_2"), ExtResource("music_3"), ExtResource("music_4"), ExtResource("music_5"), ExtResource("music_6")])
musicList = Array[AudioStream]([ExtResource("music_true_ending")])
