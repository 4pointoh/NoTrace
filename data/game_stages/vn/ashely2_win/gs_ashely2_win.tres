[resource]
script = ExtResource("stage")
name = "ashely2_win"
displayName = "Ashely Poker II - Won Match"
dialogue = ExtResource("dialogue")
dialogueStartKey = "START"
guaranteedNextGameStage = ExtResource("ending")
isCompletable = false
startingBackground = SubResource("table")
